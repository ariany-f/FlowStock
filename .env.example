# ========================================================
# CONFIGURAÇÕES DO FLOWSTOCK (App de Bebidas B2B)
# ========================================================

# 1. Supabase (Banco de Dados PostgreSQL, Storage e Auth)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# 2. Google OAuth / Sign-In
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=your-google-client-id-android.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=your-google-client-id-ios.apps.googleusercontent.com

# 3. Google Maps & Geocoding (Geolocalização dos Bares)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# 4. Mercado Pago (Pix Automático e Cartão)
EXPO_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=TEST-your-public-key
MERCADO_PAGO_ACCESS_TOKEN=TEST-your-access-token
